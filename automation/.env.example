# Copy this file to the PROJECT ROOT as `.env` and fill in your key.
#
#     cp automation/.env.example .env
#     # then edit .env and paste the key
#
# `.env` is git-ignored. Never commit the key, and never paste it into a chat.

AZURE_OPENAI_API_KEY=paste-your-azure-key-here

# The full Responses API URL for your Azure AI Foundry resource.
AZURE_OPENAI_ENDPOINT=https://tasting-resource.services.ai.azure.com/openai/v1/responses

# Your deployment name (what you named the model in Azure AI Foundry),
# not necessarily the underlying model family.
AZURE_OPENAI_MODEL=gpt-6-astra

# Optional: seconds to wait on a single request.
# LF_TIMEOUT=180

# Optional: set to 1 to exercise the whole pipeline with canned replies and
# no network calls. Useful for testing on a machine that can't reach Azure.
# LF_MOCK=1

# Optional: where Blender lives, if it is not on your PATH or in
# /Applications. Point at the .app bundle or the binary inside it.
# LF_BLENDER=/Volumes/Samsung/applications/Blender.app

# Optional: use a container instead of a native Blender.
# LF_BLENDER_MODE=docker
# LF_BLENDER_DOCKER=blenderkit/headless-blender:multi-version
# LF_BLENDER_DOCKER_PLATFORM=linux/amd64
